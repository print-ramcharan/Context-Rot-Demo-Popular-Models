# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
DEMO_USERNAME=demo
DEMO_PASSWORD=123456
AUTH_SECRET_KEY=replace-this-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760

# Production requirements:
# APP_ENV=production
# DEMO_USERNAME=<deployment account>
# DEMO_PASSWORD=<strong unique password>
# AUTH_SECRET_KEY=<at least 32 random bytes>
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
